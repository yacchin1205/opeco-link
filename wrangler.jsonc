{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "opeco-link",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-26",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "opeco.link",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./.web-dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  // Per-caller limits on the operations that create server-side state. The keys
  // are chosen in worker.ts; each binding carries one limit per minute.
  "ratelimits": [
    { "name": "SESSION_CREATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "PAIRING_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "REGISTRATION_LIMIT", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
    { "name": "EVENT_LIMIT", "namespace_id": "1004", "simple": { "limit": 300, "period": 60 } },
    { "name": "RESPONSE_LIMIT", "namespace_id": "1005", "simple": { "limit": 60, "period": 60 } }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "opeco-link-attachments"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "Session"
      },
      {
        "name": "GROUPS",
        "class_name": "DeviceGroup"
      },
      {
        "name": "DEVICES",
        "class_name": "DeviceRegistry"
      },
      {
        "name": "DEVICE_REQUESTS",
        "class_name": "DeviceRequest"
      }
    ]
  },
  "exports": {
    "Session": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "DeviceGroup": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "DeviceRegistry": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "DeviceRequest": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
